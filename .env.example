# ======================================================
# CONFIGURACIÓN DE ENTORNOS - CENSO IGLESIA IDP AEROPUERTO
# ======================================================

PORT=3000
NODE_ENV=development

# ID de la Hoja de Google Sheets (Extraído de la URL: https://docs.google.com/spreadsheets/d/TU_SHEET_ID/edit)
GOOGLE_SHEET_ID=tu_spreadsheet_id_aqui

# ------------------------------------------------------
# OPCIÓN A: Pegar la RUTA de tu archivo .json descargado (Recomendado)
# Coloca tu archivo .json en la raíz del proyecto (ej: credentials.json) e indica su ruta aquí:
GOOGLE_APPLICATION_CREDENTIALS=credentials.json

# ------------------------------------------------------
# OPCIÓN B: Pegar todo el contenido del JSON en una sola línea
# GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"..."}'

# ------------------------------------------------------
# OPCIÓN C: Copiar los datos del JSON individualmente
# GOOGLE_SERVICE_ACCOUNT_EMAIL=censo-sa@tu-proyecto.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\ntu_private_key_aqui\n-----END PRIVATE KEY-----\n"
