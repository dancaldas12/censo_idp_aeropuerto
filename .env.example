# ==============================================================================
# CONFIGURACIÓN DE ENTORNOS - CENSO IGLESIA DE DIOS DE LA PROFECÍA AEROPUERTO
# ==============================================================================

PORT=3000
NODE_ENV=development

# 1. ID de la Hoja de Google Sheets
# Extraído de la URL: https://docs.google.com/spreadsheets/d/TU_GOOGLE_SHEET_ID/edit
GOOGLE_SHEET_ID=tu_spreadsheet_id_aqui

# ==============================================================================
# AUTENTICACIÓN GOOGLE CLOUD (Elige una opción)
# ==============================================================================

# OPCIÓN 1 (Recomendada para VERCEL): Variables individuales
# Copia client_email y private_key directamente de tu archivo credentials.json
GOOGLE_SERVICE_ACCOUNT_EMAIL=censo-sa@tu-proyecto.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\ntu_clave_privada_aqui\n-----END PRIVATE KEY-----\n"

# OPCIÓN 2 (Alternativa para Vercel): Todo el contenido de credentials.json en una sola línea
# GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"..."}'

# OPCIÓN 3 (Recomendada para Desarrollo Local / Docker): Ruta al archivo JSON
# Coloca credentials.json en la raíz del proyecto:
# GOOGLE_APPLICATION_CREDENTIALS=credentials.json
